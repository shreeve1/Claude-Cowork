#!/bin/sh
# Refuse a push only when the pushed commits touch memory/ or a client folder: `clients`, plus every `client_folder`
# that memory/schema.json names at the pushed tip, at the remote tip, or in any outgoing commit that changed it.
# The working tree is never read, so pushing another branch or a tag cannot dodge the check.
# Reads the pre-push stdin protocol: "<local ref> <local sha> <remote ref> <remote sha>".
# A new branch (remote sha all zeros) is checked across its whole history.
# Merge commits are diffed against every parent (-m), so a file added only while
# resolving a merge is still seen. A git error refuses the push: unknown means unsafe.
# Exception: a repo whose own .git/config sets hooks.publishRelease=true is a published Release (set by the
# exporter); its memory/ holds starter notes meant to ship. A copied workspace never carries .git/config.

ZERO=0000000000000000000000000000000000000000

refuse() {
    echo "pre-push: push to $1 refused: $2" >&2
    echo "pre-push: memory/ and the client folder hold private notes; they must never reach a remote." >&2
    echo "pre-push: push with --no-verify only if you are certain that is safe." >&2
    exit 1
}

[ "$(git config --local --get hooks.publishRelease 2>/dev/null)" = "true" ] && exit 0

# Client folder named by memory/schema.json at commit $1: prints it, prints nothing when the file or the key is
# absent, and fails (unknown means unsafe) when the file cannot be read, holds a backslash escape (JSON can spell
# the key without the literal text), names the key twice, or gives a value that is not one lowercase word.
folder_at() {
    git rev-parse --verify --quiet "$1:memory/schema.json" >/dev/null 2>&1 || return 0
    blob=$(git cat-file -p "$1:memory/schema.json" 2>/dev/null) || return 1
    case "$blob" in *\\*) return 1 ;; esac
    printf '%s' "$blob" | grep -q 'client_folder' || return 0
    [ "$(printf '%s\n' "$blob" | grep -o 'client_folder' | wc -l)" -eq 1 ] || return 1
    name=$(printf '%s\n' "$blob" | sed -n 's/.*"client_folder"[[:space:]]*:[[:space:]]*"\([a-z][a-z0-9-]*\)".*/\1/p' | head -n 1)
    [ -n "$name" ] || return 1
    printf '%s\n' "$name"
}

while read local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    [ "$local_sha" = "$ZERO" ] && continue
    kind=$(git cat-file -t "$local_sha" 2>/dev/null) || refuse "$remote_ref" "could not read what is being pushed"
    case "$kind" in
        commit) ;;
        tag) git rev-parse --verify --quiet "$local_sha^{commit}" >/dev/null \
                 || refuse "$remote_ref" "a tag that does not point at a commit cannot be checked" ;;
        *) refuse "$remote_ref" "only commits and tags of commits can be pushed (this is a $kind)" ;;
    esac
    if [ "$remote_sha" = "$ZERO" ]; then
        commits=$(git rev-list "$local_sha" 2>/dev/null) || refuse "$remote_ref" "could not list commits to push"
    else
        commits=$(git rev-list "$remote_sha".."$local_sha" 2>/dev/null) || refuse "$remote_ref" "could not list commits to push"
    fi
    [ -n "$commits" ] || continue
    base=""
    range="$local_sha"
    if [ "$remote_sha" != "$ZERO" ]; then base="$remote_sha"; range="$local_sha ^$remote_sha"; fi
    schema_commits=$(git rev-list --full-history $range -- memory/schema.json 2>/dev/null) \
        || refuse "$remote_ref" "could not list commits that changed memory/schema.json"
    folders="clients"
    for c in $local_sha $base $schema_commits; do
        f=$(folder_at "$c") || refuse "$remote_ref" "could not read client_folder in memory/schema.json at $c"
        folders="$folders $f"
    done
    hit=$(printf '%s\n' "$commits" | git -c core.quotepath=off diff-tree -m --root --no-commit-id --name-only -r --stdin -- memory $folders 2>/dev/null) \
        || refuse "$remote_ref" "could not read the changed files"
    [ -z "$hit" ] || refuse "$remote_ref" "it includes $(printf '%s\n' "$hit" | head -n 1)"
done

exit 0